import heapq

start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

def heuristic(state):
    distance = 0
    for i, value in enumerate(state):
        if value != 0:
            target = goal.index(value)
            distance += abs(i // 3 - target // 3)
            distance += abs(i % 3 - target % 3)
    return distance

def neighbors(state):
    zero = state.index(0)
    r, c = divmod(zero, 3)

    for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
        nr, nc = r + dr, c + dc
        if 0 <= nr < 3 and 0 <= nc < 3:
            j = nr * 3 + nc
            new = list(state)
            new[zero], new[j] = new[j], new[zero]
            yield tuple(new)

def astar(start, goal):
    pq = [(heuristic(start), 0, start, [start])]
    best = {start: 0}

    while pq:
        f, g, state, path = heapq.heappop(pq)

        if state == goal:
            return path

        if g != best[state]:
            continue

        for nxt in neighbors(state):
            new_g = g + 1
            if new_g < best.get(nxt, float("inf")):
                best[nxt] = new_g
                heapq.heappush(
                    pq, (new_g + heuristic(nxt),
                         new_g, nxt, path + [nxt])
                )
    return None

result = astar(start, goal)
if result:
    for state in result:
        print(state[:3])
        print(state[3:6])
        print(state[6:])
        print()
else:
    print("No solution")
