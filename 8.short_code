def winner(b, p):
    lines = [
        (0, 1, 2), (3, 4, 5), (6, 7, 8),
        (0, 3, 6), (1, 4, 7), (2, 5, 8),
        (0, 4, 8), (2, 4, 6)
    ]
    return any(all(b[i] == p for i in line) for line in lines)

def minimax(b, maximizing):
    if winner(b, "X"):
        return 1
    if winner(b, "O"):
        return -1
    if " " not in b:
        return 0

    if maximizing:
        best = -float("inf")
        for i in range(9):
            if b[i] == " ":
                b[i] = "X"
                best = max(best, minimax(b, False))
                b[i] = " "
        return best
    else:
        best = float("inf")
        for i in range(9):
            if b[i] == " ":
                b[i] = "O"
                best = min(best, minimax(b, True))
                b[i] = " "
        return best

def best_move(b):
    best_score = -float("inf")
    move = None

    for i in range(9):
        if b[i] == " ":
            b[i] = "X"
            score = minimax(b, False)
            b[i] = " "

            if score > best_score:
                best_score = score
                move = i

    return move

board = [" "] * 9
board[4] = "O"  # Example: human has played the center

move = best_move(board)
if move is not None:
    board[move] = "X"

for i in range(0, 9, 3):
    print("|".join(board[i:i+3]))
    if i < 6:
        print("-" * 5)
