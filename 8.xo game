import math

board = [' '] * 9
wins = [(0,1,2),(3,4,5),(6,7,8),(0,3,6),
        (1,4,7),(2,5,8),(0,4,8),(2,4,6)]

def winner(p):
    return any(all(board[i] == p for i in w) for w in wins)

def minimax(maximizing):
    if winner('O'): return 1
    if winner('X'): return -1
    if ' ' not in board: return 0

    scores = []
    for i in range(9):
        if board[i] == ' ':
            board[i] = 'O' if maximizing else 'X'
            scores.append(minimax(not maximizing))
            board[i] = ' '
    return (max if maximizing else min)(scores)

def show():
    for i in range(0, 9, 3):
        print(' | '.join(board[i:i+3]))
        if i < 6: print('--+---+--')

def ai_move():
    best, move = -math.inf, 0
    for i in range(9):
        if board[i] == ' ':
            board[i] = 'O'
            score = minimax(False)
            board[i] = ' '
            if score > best:
                best, move = score, i
    board[move] = 'O'

while True:
    show()
    try:
        pos = int(input("Enter position (1-9): ")) - 1
        if pos not in range(9) or board[pos] != ' ':
            print("Invalid move!")
            continue
    except ValueError:
        print("Enter a number!")
        continue

    board[pos] = 'X'

    if winner('X'):
        show()
        print("You Win!")
        break
    if ' ' not in board:
        show()
        print("Draw!")
        break

    ai_move()
    if winner('O'):
        show()
        print("AI Wins!")
        break
    if ' ' not in board:
        show()
        print("Draw!")
        break
